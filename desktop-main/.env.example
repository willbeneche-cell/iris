# Local development default: http://localhost:1337
# Production default: https://api.tryliner.fun (or custom instance)
VITE_API_URL=http://localhost:1337
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun

# Web/PWA builds (Vercel) have no native signer: leave VITE_API_URL unset, or set
# it to /api to use the serverless proxy in api/[...path].ts. In a production
# browser build the legacy host is rewritten to /api automatically.
# VITE_API_URL=/api
#
# Server-only variables for that proxy (never prefix them with VITE_
# IRIS_API_UPSTREAM=https://api.tryliner.fun
# IRIS_SIGNING_SECRET=            # optional: otherwise the bundled signer WASM is used

# Supabase — Project Settings → API (la clé anon est publique, la sécurité
# repose sur les policies RLS de supabase/migrations/).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

IRIS_DEV_SIGNING_SECRET=
